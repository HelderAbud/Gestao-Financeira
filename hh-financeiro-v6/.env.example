# Copie para .env na raiz do monorepo (não commitar).
# Portas canônicas: API 8083 · Web 5175 · Postgres host 5434
# Ver: Desktop/Agentes/PORTFOLIO-PORTS.md

POSTGRES_PASSWORD=troque-por-senha-local-forte
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/hh_finance
SPRING_DATASOURCE_USERNAME=hh
SPRING_DATASOURCE_PASSWORD=troque-por-senha-local-forte

HH_JWT_SECRET=troque-por-segredo-jwt-com-pelo-menos-32-chars
HH_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Frontend (apps/web) em desenvolvimento:
NEXT_PUBLIC_API_URL=http://localhost:8083

# Opcional — análise com modelo:
# OPENAI_API_KEY=
# HH_OPENAI_MODEL=gpt-4o-mini

# Deploy (Render / Railway) — definir no painel, não no Git:
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/db?sslmode=require
